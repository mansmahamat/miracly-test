{
  "name": "miracly-video-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node src/server.js",
    "worker": "node src/worker.js",
    "validate": "node src/cli.js validate",
    "render": "node src/cli.js render",
    "render:video": "npx hyperframes@0.8.139 render -c",
    "voice": "node src/cli.js voice",
    "mux": "node src/cli.js mux",
    "render:all": "node src/cli.js render-all --mock-llm",
    "batch": "node src/batch.js",
    "posters": "node src/posters.js",
    "check:templates": "node src/check-templates.js",
    "test": "node --test tests/*.test.js",
    "verify": "npm test && npm run check:templates",
    "doctor": "npx hyperframes@0.8.139 doctor",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "hyperframes": "^0.8.139",
    "wrangler": "^4.153.0"
  },
  "dependencies": {
    "gsap": "^3.14.2"
  }
}
